{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Annota",
  "version": "0.1.0",
  "identifier": "app.annota",
  "build": {
    "frontendDist": "public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "mcp-server": {
      "port": 8794,
      "toolNameCase": "snake"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Annotate videos and web content",
    "longDescription": "Annota adds shareable, time- and region-anchored annotations to videos and web content."
  }
}
