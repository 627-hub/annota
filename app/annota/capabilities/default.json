{
  "$schema": "https://schema.tauri.app/config/v2",
  "identifier": "default",
  "description": "Default capabilities for the Annota spike",
  "windows": ["main"],
  "webviews": ["toolbar", "browser"],
  "remote": {
    "urls": [
      "http://127.0.0.1:8793/*",
      "http://localhost:8793/*",
      "https://*/*",
      "http://*/*"
    ]
  },
  "permissions": [
    "core:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-image",
    "clipboard-manager:allow-write-html",
    "screenshots:default",
    "updater:default",
    "process:allow-restart",
    "mcp-server:default",
    "allow-capture-frame",
    "allow-write-clipboard",
    "allow-va-fetch",
    "allow-navigate-browser",
    "allow-browser-action",
    "allow-bridge-probe-reply",
    "allow-agent-run",
    "allow-agent-chat",
    "allow-agent-cancel",
    "allow-install-update"
  ]
}
