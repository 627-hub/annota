{
  "manifest_version": 3,
  "name": "Annota",
  "version": "0.1.0",
  "description": "给视频和网页内容添加可共享标注（框选、时间锚点与同步）",
  "host_permissions": ["http://*/*", "https://*/*"],
  "permissions": ["activeTab"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["core.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "minimum_chrome_version": "109"
}
